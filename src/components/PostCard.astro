---
// One post in a list. On phones it becomes a compact row (title + small square image).
import Thumb from './Thumb.astro';
import CatLabel from './CatLabel.astro';
import { categories } from '../data/site';
import { formatDate, readingLabel, mainCategory, type Post } from '../data/posts';
interface Props { post: Post; headingLevel?: 'h2' | 'h3'; showCategory?: boolean }
const { post, headingLevel = 'h3', showCategory = true } = Astro.props;
const { title, image, excerpt, date } = post.data;
const cat = mainCategory(post, categories);
const url = `/posts/${post.id}`;
const H = headingLevel;
---
<article class="post" data-title={title} data-text={excerpt ?? ''} data-cats={post.data.categories.join(' ') + (post.data.experience ? ' experience' : '')}>
  <a href={url} tabindex="-1" aria-hidden="true"><Thumb src={image} tone={cat} /></a>
  <H class="story-title"><a href={url}>{title}</a></H>
  {excerpt && <p class="excerpt">{excerpt}</p>}
  <div class="meta">
    {showCategory && cat && <CatLabel slug={cat} />}
    <span><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></span>
    <span>{readingLabel(post.body)}</span>
  </div>
</article>
