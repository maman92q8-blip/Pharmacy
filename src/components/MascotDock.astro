---
// Hawan + Capsy (the capsule): small animated characters in the corner of every page.
// They bob and wave on their own and change their message every few seconds.
// Tapping the capsule opens Capsy, the site assistant; tapping Hawan makes them do a trick.
import Hawan from './Hawan.astro';
import PillBuddy from './PillBuddy.astro';
interface Props { path: string }
const { path } = Astro.props;
const lines: Record<string, string[]> = {
  '/': ['أهلاً! أنا هاون، وهذي Capsy', 'اضغط على الكبسولة واسألها!', 'دوّر على تجربة تشبه خطتك'],
  '/blog': ['دوّر على المقال اللي تبيه', 'جرّب تكتب: فارم دي'],
  '/category': ['تجارب حقيقية من طلاب', 'اختار المقال اللي يشبه خطتك'],
  '/experiences': ['تجارب حقيقية من طلاب', 'بريطانيا؟ أمريكا؟ اختار!'],
  '/library': ['أبحاث من الكويت والخليج', 'اضغط على الدراسة تقراها'],
  '/resources': ['دورات مجانية!', 'شفت قنوات اليوتيوب؟'],
  '/policies': ['تأكد دايماً من النص الرسمي', 'ابحث برقم القرار'],
  '/consultations': ['احجز استشارتك'],
  '/about': ['هذي موضي، صاحبة الموقع'],
  '/posts': ['قراءة ممتعة', 'عندك سؤال؟ اضغط على Capsy'],
};
const key = Object.keys(lines).filter((k) => k !== '/' && path.startsWith(k))[0] ?? (path === '/' ? '/' : '/blog');
const msgs = [...lines[key], 'اضغط على الكبسولة واسأل Capsy'].filter((m, i, a) => a.indexOf(m) === i);
---
<aside class="dock" aria-label="هاون و Capsy" data-dock hidden>
  <p class="dock-bubble" data-bubble aria-live="polite">{msgs[0]}
    <button type="button" class="dock-close" data-close aria-label="تصغير هاون و Capsy"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </p>
  <div class="dock-chars" data-chars data-msgs={JSON.stringify(msgs)}>
    <button type="button" class="dock-hawan" data-hawan aria-label="رسالة جديدة من هاون"><Hawan size={76} animate={false} decorative /></button>
    <button type="button" class="dock-capsy" data-open-capsy aria-label="اسأل Capsy، مساعد الموقع"><PillBuddy class="dock-pill" /></button>
  </div>
</aside>
<button type="button" class="dock-show" data-show aria-label="إظهار هاون و Capsy" aria-expanded="false"><Hawan size={40} animate={false} decorative /></button>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]')!;
  const show = document.querySelector<HTMLButtonElement>('[data-show]')!;
  const bubble = dock.querySelector<HTMLElement>('[data-bubble]')!;
  const close = dock.querySelector<HTMLButtonElement>('[data-close]')!;
  const chars = dock.querySelector<HTMLElement>('[data-chars]')!;
  const msgs: string[] = JSON.parse(chars.dataset.msgs || '[]');
  const pref = () => { try { return localStorage.getItem('dock-hidden') === '1'; } catch { return false; } };
  const save = (v: boolean) => { try { localStorage.setItem('dock-hidden', v ? '1' : '0'); } catch {} };
  let i = 0;
  const textNode = bubble.firstChild!;
  function setOpen(open: boolean) {
    dock.hidden = !open; show.hidden = open; show.setAttribute('aria-expanded', String(open));
  }
  function trick() {
    i = (i + 1) % msgs.length;
    textNode.textContent = msgs[i];
    bubble.classList.remove('pop'); void bubble.offsetWidth; bubble.classList.add('pop');
    const t = tricks[i % tricks.length];
    chars.classList.remove(...tricks); void chars.offsetWidth; chars.classList.add(t);
    setTimeout(() => chars.classList.remove(t), 1100);
  }
  const tricks = ['jump', 'spin', 'wiggle'];
  setOpen(!pref());
  close.addEventListener('click', () => { setOpen(false); save(true); show.focus(); });
  show.addEventListener('click', () => { setOpen(true); save(false); trick(); });
  dock.querySelector('[data-hawan]')!.addEventListener('click', trick);
  // every 5 seconds: next message and a different trick (not when reduced motion is requested)
  const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!calm) setInterval(() => { if (!dock.hidden && !document.hidden) trick(); }, 5000);
</script>
