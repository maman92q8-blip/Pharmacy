---
// Hawan + حبّة: small characters in the corner. They stay still and only move when tapped.
// Wide screens: shown open in the page margin. Smaller screens: folded into one small button so they never cover text.
import Hawan from './Hawan.astro';
import PillBuddy from './PillBuddy.astro';
interface Props { path: string }
const { path } = Astro.props;
const lines: Record<string, string[]> = {
  '/': ['أهلاً! أنا هاون، وهذي حبّة', 'دوّر على تجربة تشبه خطتك', 'جرّب تقرأ آخر مقال'],
  '/blog': ['دوّر على المقال اللي تبيه', 'جرّب تكتب: فارم دي'],
  '/category': ['تجارب حقيقية من طلاب', 'اختار المقال اللي يشبه خطتك'],
  '/experiences': ['تجارب حقيقية من طلاب', 'بريطانيا؟ أمريكا؟ اختار!'],
  '/library': ['أبحاث من الكويت والخليج', 'اضغط على الدراسة تقراها'],
  '/resources': ['دورات مجانية!', 'شفت قنوات اليوتيوب؟'],
  '/policies': ['تأكد دايماً من النص الرسمي', 'ابحث برقم القرار'],
  '/consultations': ['احجز استشارتك'],
  '/about': ['هذي موضي، صاحبة الموقع'],
  '/posts': ['قراءة ممتعة', 'المقالات ذات الصلة تحت'],
};
const key = Object.keys(lines).filter((k) => k !== '/' && path.startsWith(k))[0] ?? (path === '/' ? '/' : '/blog');
const msgs = lines[key];
---
<aside class="dock" aria-label="هاون وحبّة" data-dock hidden>
  <p class="dock-bubble" data-bubble aria-live="polite">{msgs[0]}
    <button type="button" class="dock-close" data-close aria-label="تصغير هاون وحبّة"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </p>
  <button type="button" class="dock-chars" data-chars data-msgs={JSON.stringify(msgs)} aria-label="رسالة جديدة من هاون">
    <span class="dock-hawan"><Hawan size={76} animate={false} decorative /></span>
    <PillBuddy class="dock-pill" />
  </button>
</aside>
<button type="button" class="dock-show" data-show aria-label="إظهار هاون وحبّة" aria-expanded="false"><Hawan size={40} animate={false} decorative /></button>

<script>
  const dock = document.querySelector<HTMLElement>('[data-dock]')!;
  const show = document.querySelector<HTMLButtonElement>('[data-show]')!;
  const bubble = dock.querySelector<HTMLElement>('[data-bubble]')!;
  const close = dock.querySelector<HTMLButtonElement>('[data-close]')!;
  const chars = dock.querySelector<HTMLElement>('[data-chars]')!;
  const msgs: string[] = JSON.parse(chars.dataset.msgs || '[]');
  const wide = matchMedia('(min-width: 1480px)');
  const pref = () => { try { return localStorage.getItem('dock-hidden') === '1'; } catch { return false; } };
  const save = (v: boolean) => { try { localStorage.setItem('dock-hidden', v ? '1' : '0'); } catch {} };
  let i = 0;
  const textNode = bubble.firstChild!;
  function setOpen(open: boolean) {
    dock.hidden = !open; show.hidden = open; show.setAttribute('aria-expanded', String(open));
  }
  function trick() {
    i = (i + 1) % msgs.length;
    textNode.textContent = msgs[i];
    bubble.classList.remove('pop'); void bubble.offsetWidth; bubble.classList.add('pop');
    chars.classList.remove('jump'); void chars.offsetWidth; chars.classList.add('jump');
  }
  setOpen(wide.matches && !pref());
  wide.addEventListener('change', () => setOpen(wide.matches && !pref()));
  close.addEventListener('click', () => { setOpen(false); if (wide.matches) save(true); show.focus(); });
  show.addEventListener('click', () => { setOpen(true); if (wide.matches) save(false); chars.classList.add('jump'); });
  chars.addEventListener('click', trick);
  chars.addEventListener('animationend', () => chars.classList.remove('jump'));
</script>
