---
// Hawan, the RXperiences mascot (mortar & pestle). size = width in px.
interface Props { size?: number; animate?: boolean }
const { size = 260, animate = true } = Astro.props;
---
<svg role="img" aria-label="هاون، شخصية الموقع" width={size} height={size * 1.1} viewBox="0 0 300 330">
  <g class:list={{ "hawan-body": animate }}>
  <g class:list={{ stir: animate }}><rect x="168" y="22" width="30" height="150" rx="15" transform="rotate(22 183 97)" fill="#F7C948" stroke="#1E2A4A" stroke-width="5"/></g>
  <path d="M56 150h188l-14 92a40 40 0 0 1-40 34h-80a40 40 0 0 1-40-34z" fill="#8E9BC0" stroke="#1E2A4A" stroke-width="5" stroke-linejoin="round"/>
  <rect x="44" y="134" width="212" height="28" rx="14" fill="#F48FB1" stroke="#1E2A4A" stroke-width="5"/>
  <rect x="104" y="276" width="92" height="22" rx="10" fill="#F48FB1" stroke="#1E2A4A" stroke-width="5"/>
  <circle cx="120" cy="204" r="20" fill="#FFFFFF" stroke="#1E2A4A" stroke-width="5"/>
  <circle cx="180" cy="204" r="20" fill="#FFFFFF" stroke="#1E2A4A" stroke-width="5"/>
  <path d="M140 204h20" stroke="#1E2A4A" stroke-width="5"/>
  <circle class:list={{ blink: animate }} cx="122" cy="206" r="7" fill="#1E2A4A"/><circle class:list={{ blink: animate }} cx="182" cy="206" r="7" fill="#1E2A4A"/>
  <path d="M132 244q18 14 36 0" fill="none" stroke="#1E2A4A" stroke-width="5" stroke-linecap="round"/>
  <ellipse cx="92" cy="236" rx="9" ry="5" fill="#F48FB1"/><ellipse cx="208" cy="236" rx="9" ry="5" fill="#F48FB1"/>
  </g>
</svg>
