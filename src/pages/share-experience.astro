---
// "شارك تجربتك": a questionnaire Moudhi sends to students. Their answers become a ready-to-publish
// article (same format as src/content/posts/*.md) that they send back to her.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hawan from '../components/Hawan.astro';
import { site } from '../data/site';

const countries = [
  { v: 'بريطانيا', cat: 'uk-ireland' }, { v: 'إيرلندا', cat: 'uk-ireland' },
  { v: 'أمريكا', cat: 'usa-canada' }, { v: 'كندا', cat: 'usa-canada' },
  { v: 'الكويت', cat: 'arab-countries' }, { v: 'الأردن', cat: 'arab-countries' },
  { v: 'مصر', cat: 'arab-countries' }, { v: 'السعودية', cat: 'arab-countries' },
  { v: 'دولة عربية أخرى', cat: 'arab-countries' }, { v: 'دولة أخرى', cat: '' },
];
const stages = ['فاونديشن (Foundation)', 'بكالوريوس صيدلة (BPharm / MPharm)', 'فارم دي (PharmD)', 'ماجستير (MSc)', 'دكتوراه (PhD)', 'بورد أو شهادة مهنية', 'أخرى'];

// The questions, taken from the experiences already on the site. Each becomes a heading in the article.
const questions = [
  { id: 'q-program', q: 'ما هو البرنامج وكم مدته؟', hint: 'نوع البرنامج، عدد السنوات، هل فيه سنة تحضيرية أو تدريب.' },
  { id: 'q-subjects', q: 'ما هي المواد وطبيعة المنهج؟', hint: 'أهم المواد، وهل فيه جانب عملي أو تدريب في مستشفى أو صيدلية.' },
  { id: 'q-admission', q: 'ما هي متطلبات القبول وكيف قدّمت؟', hint: 'المعدل، IELTS أو TOEFL، اختبارات، مقابلة، وكم أخذ التقديم من وقت.' },
  { id: 'q-exams', q: 'كيف طريقة التقييم والامتحانات؟', hint: 'امتحانات، assignments، OSCE، مشروع بحث…' },
  { id: 'q-difficulty', q: 'ما مستوى صعوبة الدراسة؟', hint: 'وكيف تقارنها بالدراسة في الكويت أو المدرسة.' },
  { id: 'q-city', q: 'كيف المنطقة والمعيشة؟', hint: 'الأمان، المواصلات، الجو، المطاعم والجالية العربية.' },
  { id: 'q-housing', q: 'وين سكنت وكم تكلفة المعيشة تقريباً؟', hint: 'سكن جامعي أو خاص، والإيجار الشهري التقريبي.' },
  { id: 'q-after', q: 'شنو بعد التخرج؟', hint: 'الاعتراف بالشهادة في الكويت أو الخليج، فرص العمل والتدريب.' },
  { id: 'q-best', q: 'أحلى شي وأصعب شي في التجربة؟', hint: '' },
  { id: 'q-advice', q: 'نصيحتك لطالب يفكر بنفس الطريق؟', hint: '' },
];
const contact = (site as any).submit ?? {};
---
<Base mascots={false} title="شارك تجربتك" description="شارك تجربتك في دراسة الصيدلة لتُنشر في RXperiences وتفيد طلاب الكويت والخليج.">
  <div class="page-head">
    <div class="wrap share-head">
      <div>
        <h1>شارك تجربتك</h1>
        <p>درست صيدلة في الكويت أو برا؟ جاوب على الأسئلة بأسلوبك، وموضي بتنشر تجربتك في RXperiences عشان تفيد غيرك. جاوب على اللي تعرفه فقط، والباقي خلّه فاضي.</p>
      </div>
      <div class="share-art" aria-hidden="true"><Hawan size={150} animate={false} decorative /></div>
    </div>
  </div>

  <section class="section" style="padding-top:8px">
    <div class="wrap share-wrap">
      <form class="share-form" data-share-form novalidate>
        <fieldset>
          <legend><span class="step">1</span> عنك</legend>
          <div class="field">
            <label for="f-name">اسمك كما تحب يظهر في المقال</label>
            <input id="f-name" name="name" autocomplete="name" required />
            <label class="check"><input type="checkbox" name="anon" data-anon /> أفضّل ما يظهر اسمي</label>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-country">الدولة</label>
              <select id="f-country" name="country" required>
                <option value="">اختر…</option>
                {countries.map((c) => <option value={c.v} data-cat={c.cat}>{c.v}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="f-city">المدينة <span class="opt">(اختياري)</span></label>
              <input id="f-city" name="city" />
            </div>
          </div>
          <div class="field">
            <label for="f-uni">الجامعة</label>
            <input id="f-uni" name="university" placeholder="مثلاً: University of Manchester" dir="auto" required />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-stage">المرحلة</label>
              <select id="f-stage" name="stage" required>
                <option value="">اختر…</option>
                {stages.map((s) => <option>{s}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="f-major">التخصص <span class="opt">(اختياري)</span></label>
              <input id="f-major" name="major" placeholder="مثلاً: Clinical Pharmacy" dir="auto" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-years">سنوات الدراسة <span class="opt">(اختياري)</span></label>
              <input id="f-years" name="years" placeholder="مثلاً: 2019 – 2023" dir="auto" />
            </div>
            <div class="field">
              <label for="f-sponsor">جهة الابتعاث <span class="opt">(إن وجدت)</span></label>
              <input id="f-sponsor" name="sponsor" placeholder="مثلاً: التعليم العالي" />
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend><span class="step">2</span> تجربتك</legend>
          <p class="fs-note">جاوب على ٣ أسئلة على الأقل. كل ما كانت التفاصيل أكثر، كانت التجربة أفيد.</p>
          {questions.map((q) => (
            <div class="field">
              <label for={q.id}>{q.q}</label>
              {q.hint && <p class="hint" id={`${q.id}-hint`}>{q.hint}</p>}
              <textarea id={q.id} name={q.id} rows="4" dir="auto" data-q={q.q} aria-describedby={q.hint ? `${q.id}-hint` : undefined}></textarea>
            </div>
          ))}
        </fieldset>

        <fieldset>
          <legend><span class="step">3</span> الموافقة</legend>
          <label class="check">
            <input type="checkbox" name="consent" required />
            أوافق على نشر تجربتي في RXperiences، وأعرف إن موضي ممكن تعدّل الصياغة بشكل بسيط.
          </label>
          <p class="fs-note">عندك صور للجامعة أو المدينة؟ أرسلها لموضي مع الرسالة، وتنحط مع المقال.</p>
        </fieldset>

        <p class="form-error" data-error role="alert" hidden></p>
        <button type="submit" class="btn btn-primary">جهّز تجربتي <Icon name="arrow" size={18} /></button>
        <p class="fs-note">إجاباتك تنحفظ في جهازك لو طلعت ورجعت، وما تنرسل لأي مكان إلا لما ترسلها أنت.</p>
      </form>

      <section class="share-done" data-done hidden aria-labelledby="done-title" tabindex="-1">
        <h2 id="done-title">تجربتك جاهزة!</h2>
        <p>آخر خطوة: أرسلها لموضي في نفس المحادثة اللي وصلك منها الرابط.</p>
        <div class="btns">
          <button type="button" class="btn btn-primary" data-copy><Icon name="doc" /> انسخ التجربة</button>
          <button type="button" class="btn btn-quiet" data-share hidden><Icon name="chat" /> أرسل عن طريق…</button>
          {contact.whatsapp && <a class="btn btn-quiet" data-wa href={`https://wa.me/${contact.whatsapp}`} target="_blank" rel="noopener">واتساب</a>}
          {contact.email && <a class="btn btn-quiet" data-mail href={`mailto:${contact.email}`}>إيميل</a>}
          <button type="button" class="btn btn-quiet" data-download>تحميل كملف</button>
        </div>
        <p class="copied" data-copied role="status" aria-live="polite"></p>
        <p class="fs-note">ما تعرف وين ترسلها؟ راسل موضي على <a href={site.social.instagram} target="_blank" rel="noopener">إنستغرام</a>. إذا كانت الرسالة طويلة، أرسل الملف.</p>
        <details class="preview">
          <summary>شوف شكل المقال <Icon name="chevron" size={18} /></summary>
          <div class="preview-body" data-preview></div>
        </details>
        <button type="button" class="link-more" data-edit><Icon name="arrow" size={16} flip /> رجوع للتعديل</button>
      </section>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-share-form]')!;
  const done = document.querySelector<HTMLElement>('[data-done]')!;
  const errorBox = document.querySelector<HTMLElement>('[data-error]')!;
  const anon = form.querySelector<HTMLInputElement>('[data-anon]')!;
  const nameInput = form.querySelector<HTMLInputElement>('#f-name')!;
  const KEY = 'rx-share-draft';
  let article = '', fileName = '';

  // ----- keep a draft on this device -----
  const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input, textarea, select')];
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
    for (const f of fields) if (f.name in saved) {
      if (f instanceof HTMLInputElement && f.type === 'checkbox') f.checked = !!saved[f.name]; else f.value = saved[f.name];
    }
  } catch {}
  const saveDraft = () => {
    const data: Record<string, string | boolean> = {};
    for (const f of fields) data[f.name] = f instanceof HTMLInputElement && f.type === 'checkbox' ? f.checked : f.value;
    try { localStorage.setItem(KEY, JSON.stringify(data)); } catch {}
  };
  form.addEventListener('input', saveDraft);
  const syncAnon = () => { nameInput.required = !anon.checked; nameInput.disabled = anon.checked; };
  anon.addEventListener('change', syncAnon); syncAnon();

  // ----- build the article in the site's format -----
  const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? '';
  const yaml = (s: string) => s.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/\s+/g, ' ');
  function build() {
    const country = form.querySelector<HTMLSelectElement>('#f-country')!;
    const cat = country.selectedOptions[0]?.dataset.cat || '';
    const stage = val('stage').replace(/\s*\(.*\)\s*/, '');
    const uni = val('university'), city = val('city'), major = val('major');
    const answers = [...form.querySelectorAll<HTMLTextAreaElement>('textarea[data-q]')]
      .map((t) => ({ q: t.dataset.q!, a: t.value.trim() })).filter((x) => x.a);
    const title = `تجربة ${stage}${major ? ` ${major}` : ''} في ${uni}`;
    const excerpt = answers[0]?.a.slice(0, 160) ?? '';
    const date = new Date().toISOString().slice(0, 10);
    const who = anon.checked ? `طالب/ة من ${val('country')}` : val('name');
    const facts = [
      `**الجامعة:** ${uni}`,
      city && `**المدينة:** ${city}`,
      `**الدولة:** ${val('country')}`,
      `**المرحلة:** ${val('stage')}${major ? ` – ${major}` : ''}`,
      val('years') && `**سنوات الدراسة:** ${val('years')}`,
      val('sponsor') && `**جهة الابتعاث:** ${val('sponsor')}`,
    ].filter(Boolean).join('  \n');
    // each line the student wrote becomes its own paragraph
    const body = answers.map((x) => `## ${x.q}\n\n${x.a.replace(/\r/g, '').split(/\n+/).map((l) => l.trim()).filter(Boolean).join('\n\n')}`).join('\n\n');
    article = `---
title: "${yaml(title)}"
date: ${date}
categories: [${cat ? `"${cat}"` : ''}]
experience: true
# image: "/images/اسم-الصورة.jpg"
excerpt: "${yaml(excerpt)}"
---

${facts}

${body}

**تجربة: ${who}**
`;
    const slugBase = (uni.match(/[A-Za-z]+/g) || ['experience']).slice(0, 3).join('-').toLowerCase();
    fileName = `${slugBase}-${date}.md`;
    return answers.length;
  }

  function preview() {
    const box = document.querySelector<HTMLElement>('[data-preview]')!;
    box.replaceChildren();
    const body = article.split('---').slice(2).join('---');
    for (const block of body.split(/\n\n+/)) {
      const t = block.trim(); if (!t) continue;
      const el = document.createElement(t.startsWith('## ') ? 'h3' : 'p');
      el.textContent = t.replace(/^## /, '').replace(/\*\*/g, '');
      el.setAttribute('dir', 'auto');
      box.append(el);
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    errorBox.hidden = true;
    const missing = [...form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('[required]')].find((f) =>
      f instanceof HTMLInputElement && f.type === 'checkbox' ? !f.checked : !f.value.trim());
    if (missing) {
      const label = missing.type === 'checkbox' ? 'وافق على النشر في الخطوة ٣' : `عبّي: ${form.querySelector(`label[for="${missing.id}"]`)?.textContent?.replace(/\(.*\)/, '').trim()}`;
      errorBox.textContent = `باقي شي: ${label}.`; errorBox.hidden = false; missing.focus(); return;
    }
    const n = build();
    if (n < 3) {
      errorBox.textContent = `جاوبت على ${n} من الأسئلة. جاوب على ٣ أسئلة على الأقل في خطوة «تجربتك».`;
      errorBox.hidden = false;
      [...form.querySelectorAll<HTMLTextAreaElement>('textarea[data-q]')].find((t) => !t.value.trim())?.focus();
      return;
    }
    preview();
    const wa = document.querySelector<HTMLAnchorElement>('[data-wa]');
    if (wa) wa.href = `${wa.href.split('?')[0]}?text=${encodeURIComponent(article)}`;
    const mail = document.querySelector<HTMLAnchorElement>('[data-mail]');
    if (mail) mail.href = `${mail.href.split('?')[0]}?subject=${encodeURIComponent('تجربة جديدة لـ RXperiences')}&body=${encodeURIComponent(article)}`;
    form.hidden = true; done.hidden = false; done.focus();
    window.scrollTo({ top: done.getBoundingClientRect().top + scrollY - 100 });
  });

  const status = document.querySelector<HTMLElement>('[data-copied]')!;
  document.querySelector('[data-copy]')!.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(article); status.textContent = 'تم النسخ. الصقها الحين في المحادثة مع موضي.'; }
    catch { status.textContent = 'ما قدرنا ننسخ تلقائياً. افتح «شوف شكل المقال» وانسخ النص يدوياً، أو حمّل الملف.'; }
  });
  const shareBtn = document.querySelector<HTMLButtonElement>('[data-share]')!;
  if ('share' in navigator) {
    shareBtn.hidden = false;
    shareBtn.addEventListener('click', async () => {
      const file = new File([article], fileName, { type: 'text/plain' });
      try {
        if (navigator.canShare?.({ files: [file] })) await navigator.share({ files: [file], title: 'تجربة لـ RXperiences', text: 'تجربتي لموقع RXperiences' });
        else await navigator.share({ title: 'تجربة لـ RXperiences', text: article });
      } catch {}
    });
  }
  document.querySelector('[data-download]')!.addEventListener('click', () => {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([article], { type: 'text/markdown;charset=utf-8' }));
    a.download = fileName; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  document.querySelector('[data-edit]')!.addEventListener('click', () => { done.hidden = true; form.hidden = false; form.querySelector('textarea')!.focus(); });
</script>
