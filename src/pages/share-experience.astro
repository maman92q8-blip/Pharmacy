---
// "شارك تجربتك": a questionnaire Moudhi sends to students. Pressing "أرسل تجربتي" sends it to /api/experience,
// which opens it on GitHub for Moudhi to approve (Merge) or reject (Close). If that isn't set up yet,
// the page falls back to letting the student copy or download the article and send it themselves.
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hawan from '../components/Hawan.astro';
import { site } from '../data/site';
import { COUNTRIES, STAGES, QUESTIONS } from '../lib/experience-article';

const countries = COUNTRIES, stages = STAGES, questions = QUESTIONS;
---
<Base mascots={false} title="شارك تجربتك" description="شارك تجربتك في دراسة الصيدلة لتُنشر في RXperiences وتفيد طلاب الكويت والخليج.">
  <div class="page-head">
    <div class="wrap share-head">
      <div>
        <h1>شارك تجربتك</h1>
        <p>درست صيدلة في الكويت أو برا؟ جاوب على الأسئلة بأسلوبك، وموضي بتنشر تجربتك في RXperiences عشان تفيد غيرك. جاوب على اللي تعرفه فقط، والباقي خلّه فاضي.</p>
      </div>
      <div class="share-art" aria-hidden="true"><Hawan size={150} animate={false} decorative /></div>
    </div>
  </div>

  <section class="section" style="padding-top:8px">
    <div class="wrap share-wrap">
      <form class="share-form" data-share-form novalidate>
        <fieldset>
          <legend><span class="step">1</span> عنك</legend>
          <div class="field">
            <label for="f-name">اسمك كما تحب يظهر في المقال</label>
            <input id="f-name" name="name" autocomplete="name" required />
            <label class="check"><input type="checkbox" name="anon" data-anon /> أفضّل ما يظهر اسمي</label>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-country">الدولة</label>
              <select id="f-country" name="country" required>
                <option value="">اختر…</option>
                {countries.map((c) => <option value={c.v} data-cat={c.cat}>{c.v}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="f-city">المدينة <span class="opt">(اختياري)</span></label>
              <input id="f-city" name="city" />
            </div>
          </div>
          <div class="field">
            <label for="f-uni">الجامعة</label>
            <input id="f-uni" name="university" placeholder="مثلاً: University of Manchester" dir="auto" required />
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-stage">المرحلة</label>
              <select id="f-stage" name="stage" required>
                <option value="">اختر…</option>
                {stages.map((s) => <option>{s}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="f-major">التخصص <span class="opt">(اختياري)</span></label>
              <input id="f-major" name="major" placeholder="مثلاً: Clinical Pharmacy" dir="auto" />
            </div>
          </div>
          <div class="field-row">
            <div class="field">
              <label for="f-years">سنوات الدراسة <span class="opt">(اختياري)</span></label>
              <input id="f-years" name="years" placeholder="مثلاً: 2019 – 2023" dir="auto" />
            </div>
            <div class="field">
              <label for="f-sponsor">جهة الابتعاث <span class="opt">(إن وجدت)</span></label>
              <input id="f-sponsor" name="sponsor" placeholder="مثلاً: التعليم العالي" />
            </div>
          </div>
        </fieldset>

        <fieldset>
          <legend><span class="step">2</span> تجربتك</legend>
          <p class="fs-note">جاوب على ٣ أسئلة على الأقل. كل ما كانت التفاصيل أكثر، كانت التجربة أفيد.</p>
          {questions.map((q) => (
            <div class="field">
              <label for={q.id}>{q.q}</label>
              {q.hint && <p class="hint" id={`${q.id}-hint`}>{q.hint}</p>}
              <textarea id={q.id} name={q.id} rows="4" dir="auto" data-q={q.id} aria-describedby={q.hint ? `${q.id}-hint` : undefined}></textarea>
            </div>
          ))}
        </fieldset>

        <fieldset>
          <legend><span class="step">3</span> الصور والموافقة</legend>
          <div class="field">
            <label for="f-photos">صور للجامعة أو المدينة <span class="opt">(اختياري، إلى ٣ صور)</span></label>
            <input id="f-photos" type="file" accept="image/jpeg,image/png,image/webp,image/heic" multiple data-photos />
            <div class="thumbs" data-thumbs></div>
            <p class="hint">صور التقطتها بنفسك فقط، وبدون وجوه أشخاص ما وافقوا.</p>
          </div>
          <label class="check">
            <input type="checkbox" name="consent" required />
            أوافق على نشر تجربتي في RXperiences، وأعرف إن موضي ممكن تعدّل الصياغة بشكل بسيط.
          </label>
        </fieldset>

        <div class="hp" aria-hidden="true"><label>لا تعبّي هذا الحقل <input name="website" tabindex="-1" autocomplete="off" /></label></div>
        <p class="form-error" data-error role="alert" hidden></p>
        <button type="submit" class="btn btn-primary" data-send>أرسل تجربتي <Icon name="arrow" size={18} /></button>
        <p class="fs-note">إجاباتك تنحفظ في جهازك لو طلعت ورجعت. توصل لموضي بس لما تضغط «أرسل تجربتي»، وما تنشر إلا بعد ما تراجعها.</p>
      </form>

      <section class="share-done" data-sent hidden aria-labelledby="sent-title" tabindex="-1">
        <div class="sent-art" aria-hidden="true"><Hawan size={120} animate={false} decorative /></div>
        <h2 id="sent-title">وصلت تجربتك لموضي!</h2>
        <p>شكراً لأنك شاركت. موضي بتراجعها، وأول ما تنشرها بتلقاها في <a href="/experiences">تجارب واقعية</a>.</p>
      </section>

      <section class="share-done" data-done hidden aria-labelledby="done-title" tabindex="-1">
        <h2 id="done-title">تجربتك جاهزة!</h2>
        <p data-done-why>ما قدرنا نرسلها تلقائياً الحين. انسخها أو حمّلها وأرسلها لموضي في نفس المحادثة اللي وصلك منها الرابط.</p>
        <div class="btns">
          <button type="button" class="btn btn-primary" data-copy><Icon name="doc" /> انسخ التجربة</button>
          <button type="button" class="btn btn-quiet" data-share hidden><Icon name="chat" /> أرسل عن طريق…</button>
          <button type="button" class="btn btn-quiet" data-download>تحميل كملف</button>
        </div>
        <p class="copied" data-copied role="status" aria-live="polite"></p>
        <p class="fs-note">ما تعرف وين ترسلها؟ راسل موضي على <a href={site.social.instagram} target="_blank" rel="noopener">إنستغرام</a>، وأرسل الصور معها.</p>
        <details class="preview">
          <summary>شوف شكل المقال <Icon name="chevron" size={18} /></summary>
          <div class="preview-body" data-preview></div>
        </details>
        <button type="button" class="link-more" data-edit><Icon name="arrow" size={16} flip /> رجوع للتعديل</button>
      </section>
    </div>
  </section>
</Base>

<script>
  import { buildArticle, slugFor, validate, QUESTIONS, MIN_ANSWERS, type Submission } from '../lib/experience-article';
  const form = document.querySelector<HTMLFormElement>('[data-share-form]')!;
  const done = document.querySelector<HTMLElement>('[data-done]')!;
  const sent = document.querySelector<HTMLElement>('[data-sent]')!;
  const errorBox = document.querySelector<HTMLElement>('[data-error]')!;
  const sendBtn = form.querySelector<HTMLButtonElement>('[data-send]')!;
  const anon = form.querySelector<HTMLInputElement>('[data-anon]')!;
  const nameInput = form.querySelector<HTMLInputElement>('#f-name')!;
  const photoInput = form.querySelector<HTMLInputElement>('[data-photos]')!;
  const thumbs = form.querySelector<HTMLElement>('[data-thumbs]')!;
  const KEY = 'rx-share-draft';
  let article = '', fileName = '';
  let photos: string[] = [];

  // ----- keep a draft on this device (not the photos) -----
  const fields = [...form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('input:not([type=file]), textarea, select')];
  try {
    const saved = JSON.parse(localStorage.getItem(KEY) || '{}');
    for (const f of fields) if (f.name in saved) {
      if (f instanceof HTMLInputElement && f.type === 'checkbox') f.checked = !!saved[f.name]; else f.value = saved[f.name];
    }
  } catch {}
  const saveDraft = () => {
    const data: Record<string, string | boolean> = {};
    for (const f of fields) data[f.name] = f instanceof HTMLInputElement && f.type === 'checkbox' ? f.checked : f.value;
    try { localStorage.setItem(KEY, JSON.stringify(data)); } catch {}
  };
  form.addEventListener('input', saveDraft);
  const syncAnon = () => { nameInput.required = !anon.checked; nameInput.disabled = anon.checked; };
  anon.addEventListener('change', syncAnon); syncAnon();

  // ----- photos: shrink on the phone before sending (max 1600px, JPEG) -----
  async function shrink(file: File): Promise<string> {
    const bmp = await createImageBitmap(file);
    const scale = Math.min(1, 1600 / Math.max(bmp.width, bmp.height));
    const c = document.createElement('canvas');
    c.width = Math.round(bmp.width * scale); c.height = Math.round(bmp.height * scale);
    c.getContext('2d')!.drawImage(bmp, 0, 0, c.width, c.height);
    return c.toDataURL('image/jpeg', 0.82);
  }
  photoInput.addEventListener('change', async () => {
    const files = [...(photoInput.files ?? [])].slice(0, 3);
    photos = []; thumbs.replaceChildren();
    for (const f of files) {
      try {
        const url = await shrink(f); photos.push(url);
        const img = document.createElement('img'); img.src = url; img.alt = ''; thumbs.append(img);
      } catch { errorBox.textContent = `ما قدرنا نقرأ الصورة «${f.name}». جرّب صورة JPG أو PNG.`; errorBox.hidden = false; }
    }
    if ((photoInput.files?.length ?? 0) > 3) { errorBox.textContent = 'أخذنا أول ٣ صور فقط.'; errorBox.hidden = false; }
  });

  // ----- read the form -----
  const val = (n: string) => (form.elements.namedItem(n) as HTMLInputElement | null)?.value.trim() ?? '';
  function read() {
    const answers: Record<string, string> = {};
    for (const q of QUESTIONS) { const v = val(q.id); if (v) answers[q.id] = v; }
    return {
      name: val('name'), anon: anon.checked, country: val('country'), city: val('city'), university: val('university'),
      stage: val('stage'), major: val('major'), years: val('years'), sponsor: val('sponsor'), answers,
      consent: form.querySelector<HTMLInputElement>('input[name=consent]')!.checked,
    };
  }
  function showError(msg: string, el?: HTMLElement | null) { errorBox.textContent = msg; errorBox.hidden = false; (el ?? errorBox).focus?.(); }

  function preview() {
    const box = document.querySelector<HTMLElement>('[data-preview]')!;
    box.replaceChildren();
    for (const block of article.split('---').slice(2).join('---').split(/\n\n+/)) {
      const t = block.trim(); if (!t || t.startsWith('![')) continue;
      const el = document.createElement(t.startsWith('## ') ? 'h3' : 'p');
      el.textContent = t.replace(/^## /, '').replace(/\*\*/g, ''); el.setAttribute('dir', 'auto'); box.append(el);
    }
  }
  function fallback(why?: string) {
    if (why) document.querySelector<HTMLElement>('[data-done-why]')!.textContent = why;
    preview();
    form.hidden = true; done.hidden = false; done.focus();
    window.scrollTo({ top: done.getBoundingClientRect().top + scrollY - 100 });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.hidden = true;
    const data = read();
    const v = validate(data);
    if (!v.ok) {
      // point at the field that needs attention
      const target = !data.anon && !data.name ? nameInput
        : !data.country ? form.querySelector<HTMLElement>('#f-country')
        : !data.university ? form.querySelector<HTMLElement>('#f-uni')
        : !data.stage ? form.querySelector<HTMLElement>('#f-stage')
        : Object.keys(data.answers).length < MIN_ANSWERS ? [...form.querySelectorAll<HTMLTextAreaElement>('textarea[data-q]')].find((t) => !t.value.trim())
        : form.querySelector<HTMLElement>('input[name=consent]');
      showError(`باقي شي: ${v.error}`, target);
      return;
    }
    const d: Submission = v.data;
    article = buildArticle(d).markdown;
    fileName = `${slugFor(d)}-${new Date().toISOString().slice(0, 10)}.md`;

    sendBtn.disabled = true; sendBtn.firstChild!.textContent = 'جاري الإرسال… ';
    try {
      const res = await fetch('/api/experience', {
        method: 'POST', headers: { 'content-type': 'application/json' },
        body: JSON.stringify({ ...data, photos, website: val('website') }),
      });
      const out = await res.json().catch(() => ({}));
      if (res.ok && out.ok) {
        try { localStorage.removeItem(KEY); } catch {}
        form.hidden = true; sent.hidden = false; sent.focus();
        window.scrollTo({ top: sent.getBoundingClientRect().top + scrollY - 100 });
      } else if (res.status === 400 || res.status === 429) {
        showError(out.error || 'صار خطأ، راجع الإجابات وجرّب مرة ثانية.');
      } else {
        fallback(); // not set up yet, or GitHub unavailable: let the student send it themselves
      }
    } catch {
      fallback('ما قدرنا نتصل بالموقع الحين. انسخها أو حمّلها وأرسلها لموضي في نفس المحادثة اللي وصلك منها الرابط.');
    } finally {
      sendBtn.disabled = false; sendBtn.firstChild!.textContent = 'أرسل تجربتي ';
    }
  });

  const status = document.querySelector<HTMLElement>('[data-copied]')!;
  document.querySelector('[data-copy]')!.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText(article); status.textContent = 'تم النسخ. الصقها الحين في المحادثة مع موضي.'; }
    catch { status.textContent = 'ما قدرنا ننسخ تلقائياً. افتح «شوف شكل المقال» وانسخ النص يدوياً، أو حمّل الملف.'; }
  });
  const shareBtn = document.querySelector<HTMLButtonElement>('[data-share]')!;
  if ('share' in navigator) {
    shareBtn.hidden = false;
    shareBtn.addEventListener('click', async () => {
      const file = new File([article], fileName, { type: 'text/plain' });
      try {
        if (navigator.canShare?.({ files: [file] })) await navigator.share({ files: [file], title: 'تجربة لـ RXperiences' });
        else await navigator.share({ title: 'تجربة لـ RXperiences', text: article });
      } catch {}
    });
  }
  document.querySelector('[data-download]')!.addEventListener('click', () => {
    const a = document.createElement('a');
    a.href = URL.createObjectURL(new Blob([article], { type: 'text/markdown;charset=utf-8' }));
    a.download = fileName; a.click(); setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  });
  document.querySelector('[data-edit]')!.addEventListener('click', () => { done.hidden = true; form.hidden = false; form.querySelector('textarea')!.focus(); });
</script>
