---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Hawan from '../components/Hawan.astro';
import PillBuddy from '../components/PillBuddy.astro';
import { site, categories, policyCategories } from '../data/site';
import { getPosts, formatDate, articlesLabel } from '../data/posts';

const posts = await getPosts();
const experiences = posts.filter((p) => p.data.experience);
const regions = ['uk-ireland', 'usa-canada', 'arab-countries'].map((slug) => ({ slug, ...categories[slug] }));

const when = (p: { data: { date?: Date; year?: number } }) => p.data.date?.valueOf() ?? (p.data.year ? Date.UTC(p.data.year, 0, 1) : 0);
const policies = (await getCollection('policies')).filter((p) => p.data.category !== 'official').sort((a, b) => when(b) - when(a));
const policy = policies[0];
const library = (await getCollection('library')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const study = library.find((s) => s.data.region === 'kuwait') ?? library[0];
const resources = await getCollection('resources');

// The sections a reader can choose from: a picture, a name and one line each.
const sections = [
  { href: '/experiences', title: 'تجارب واقعية', text: 'طلاب درسوا الصيدلة في بريطانيا وأمريكا والدول العربية يحكون تجربتهم.', count: articlesLabel(experiences.length), image: '/images/2022-08-02D0716D-3F63-466E-9573-BAD6F171CE74.webp', size: 'big' },
  { href: '/blog', title: 'المقالات', text: 'التخصصات، الفرق بين الفارم دي والبكالوريوس، والعمل بعد التخرج.', count: articlesLabel(posts.length), image: '/images/2022-05-5.-1.jpg', size: 'big' },
  { href: '/library', title: 'مكتبة الصيادلة', text: 'دراسات منشورة من الكويت والخليج.', count: `${library.length} دراسة`, image: '/images/library-hero.jpg', size: 'small' },
  { href: '/resources', title: 'المراجع', text: 'دورات مجانية وقنوات ومراجع وتطبيقات.', count: `${resources.length} مرجعاً`, image: '/images/2022-07-shutterstock_1460320043-1.jpg', size: 'small' },
];
---
<Base>
  <section class="hero on-dark">
    <div class="wrap hero-grid">
      <div>
        <h1 class="reveal">كل ما يتعلق بالصيدلة</h1>
        <p class="lead reveal">تجارب حقيقية لصيادلة وطلبة صيدلة في الكويت والخليج، ومراجع وأبحاث خليجية، لتساعدك تختار تخصصك وطريقك المهني.</p>
        <form class="searchbox reveal" role="search" action="/blog" method="get">
          <label for="hero-search" class="sr">ابحث في المقالات</label>
          <Icon name="search" />
          <input id="hero-search" type="search" name="q" placeholder="مثلاً: فارم دي، ماجستير، إيرلندا" autocomplete="off" enterkeyhint="search" required />
          <button type="submit">ابحث</button>
        </form>
        <nav class="regions-quick reveal" aria-labelledby="where">
          <p id="where">وين تبي تدرس؟</p>
          <ul>
            {regions.map((r) => <li><a class={`tone--${r.slug}`} href={`/category/${r.slug}`}>{r.name.replace('تجارب من ', '')}</a></li>)}
          </ul>
        </nav>
      </div>
      <div class="hero-art" aria-hidden="true">
        <span class="blob"></span>
        <Hawan class="hawan" size={300} decorative />
        <PillBuddy />
        <span class="note">أهلاً! أنا هاون</span>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="choose">
    <div class="wrap">
      <div class="section-head"><h2 id="choose">شنو تبي تقرا اليوم؟</h2></div>
      <div class="doors">
        {sections.map((s, i) => (
          <a class={`door door--${s.size}`} href={s.href}>
            <span class="door-img"><img src={s.image} alt="" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /></span>
            <span class="door-text">
              <strong>{s.title}</strong>
              <span>{s.text}</span>
              <small>{s.count} <Icon name="arrow" size={16} /></small>
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section updates" aria-label="آخر التحديثات">
    <div class="wrap pair">
      {policy && (
        <div class="update update--policy">
          <h2>سياسات وزارة الصحة</h2>
          <div class="one">
            <span class="num">{policy.data.number ?? policy.data.year}</span>
            <strong>{policy.data.title}</strong>
            <small>{policyCategories[policy.data.category]}{policy.data.date && ` – ${formatDate(policy.data.date)}`}</small>
          </div>
          <a href="/policies" class="btn btn-primary">تصفح كل السياسات ({policies.length}) <Icon name="arrow" size={18} /></a>
        </div>
      )}
      {study && (
        <div class="update update--study">
          <h2>دراسة من {study.data.country}</h2>
          <a class="one" href={study.data.url} target="_blank" rel="noopener">
            <strong class="ltr-title">{study.data.title}</strong>
            <small><span class="ltr">{[study.data.journal, study.data.year].filter(Boolean).join(', ')}</span></small>
          </a>
          <a href="/library" class="btn btn-primary">تصفح كل الدراسات ({library.length}) <Icon name="arrow" size={18} /></a>
        </div>
      )}
    </div>
  </section>

</Base>
