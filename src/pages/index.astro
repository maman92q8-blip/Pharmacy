---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import Icon from '../components/Icon.astro';
import Hawan from '../components/Hawan.astro';
import { site, categories } from '../data/site';
import { getPosts } from '../data/posts';
const posts = (await getPosts()).slice(0, 6);
const regions = ['uk-ireland', 'usa-canada', 'arab-countries'];
---
<Base>
  <section class="hero">
    <div class="wrap">
      <div>
        <span class="hello">💬 أهلاً، أنا هاون!</span>
        <h1>كل ما يتعلق بـ<mark>الصيدلة</mark></h1>
        <p class="en">{site.taglineEn}</p>
        <p class="lead">تجارب حقيقية لصيادلة وطلبة صيدلة في الكويت وحول العالم، ومراجع وأبحاث خليجية، لتساعدك تختار تخصصك وطريقك المهني.</p>
        <div class="btns">
          <a href="/blog" class="btn btn-primary"><Icon name="book" /> اقرأ المقالات</a>
          <a href="/library" class="btn btn-ghost"><Icon name="library" /> مكتبة الصيادلة</a>
        </div>
      </div>
      <div class="hero-art"><Hawan size={240} /></div>
      <svg class="pill" aria-hidden="true" width="80" height="38" viewBox="0 0 84 40" style="top:28px;left:44%;--r:-20deg"><rect x="2" y="2" width="80" height="36" rx="18" fill="#F7C948" stroke="#1E2A4A" stroke-width="2.5"/><path d="M42 2v36" stroke="#1E2A4A" stroke-width="2.5"/></svg>
      <svg class="pill" aria-hidden="true" width="44" height="44" viewBox="0 0 48 48" style="bottom:18px;left:40%"><circle cx="24" cy="24" r="21" fill="#8E9BC0" stroke="#1E2A4A" stroke-width="2.5"/><path d="M11 24h26" stroke="#1E2A4A" stroke-width="2.5" stroke-linecap="round"/></svg>
      <svg class="pill" aria-hidden="true" width="72" height="34" viewBox="0 0 76 36" style="bottom:30px;left:16px;--r:25deg"><rect x="2" y="2" width="72" height="32" rx="16" fill="#F48FB1" stroke="#1E2A4A" stroke-width="2.5"/><path d="M38 2v32" stroke="#1E2A4A" stroke-width="2.5"/></svg>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div><h2>أحدث المقالات</h2><p>جديد المواضيع المتعلقة بالصيدلة</p></div>
        <a href="/blog" class="more">كل المقالات <Icon name="arrow" size={18} /></a>
      </div>
      <div class="grid">{posts.map((p) => <PostCard post={p} />)}</div>
    </div>
  </section>

  <section class="section" style="background:#fff;border-block:1px solid var(--line)">
    <div class="wrap">
      <div class="section-head">
        <div><h2>تجارب واقعية</h2><p>تجارب طلاب درسوا الصيدلة في دول مختلفة</p></div>
        <a href="/experiences" class="more">كل التجارب <Icon name="arrow" size={18} /></a>
      </div>
      <div class="regions">
        {regions.map((r) => (
          <a class="region" href={`/category/${r}`}>
            <img src={categories[r].image} alt="" loading="lazy" />
            <div><strong>{categories[r].name}</strong><small>{categories[r].nameEn}</small></div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="policy-banner">
        <div class="badge"><Icon name="shield" size={32} /></div>
        <div>
          <h2>سياسات وقرارات وزارة الصحة الكويتية</h2>
          <p>القوانين والقرارات الوزارية الخاصة بالصيدلة وتراخيص المهنة والأدوية في مكان واحد.</p>
          <a href="/policies" class="btn btn-primary">تصفح السياسات <Icon name="arrow" size={18} /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <div class="cta" style="max-width:none;margin:0">
        <p>تفقد قناتنا على اليوتيوب، أو احجز استشارة خاصة</p>
        <div class="btns">
          <a href={site.social.youtube} class="btn btn-teal"><Icon name="youtube" /> YouTube</a>
          <a href="/consultations" class="btn btn-primary"><Icon name="chat" /> الاستشارات</a>
        </div>
      </div>
    </div>
  </section>
</Base>
