---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import CatLabel from '../../components/CatLabel.astro';
import Icon from '../../components/Icon.astro';
import Hawan from '../../components/Hawan.astro';
import { render } from 'astro:content';
import { categories, site } from '../../data/site';
import { getPosts, formatDate, readingLabel, mainCategory } from '../../data/posts';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post, posts } }));
}
const { post, posts } = Astro.props;
const { Content, headings } = await render(post);
const { title, image, date, excerpt } = post.data;
const cats = post.data.categories.filter((c) => categories[c]);
const tone = mainCategory(post, categories) ?? 'none';
const related = posts.filter((p) => p.id !== post.id && p.data.categories.some((c) => cats.includes(c))).slice(0, 3);
const more = related.length ? related : posts.filter((p) => p.id !== post.id).slice(0, 3);
const i = posts.findIndex((p) => p.id === post.id);
const newer = i > 0 ? posts[i - 1] : undefined;
const older = i < posts.length - 1 ? posts[i + 1] : undefined;
// Contents list only when the article is long enough to need one
const toc = headings.filter((h) => h.depth <= 3);
const hasToc = toc.length >= 4;
---
<Base title={title} description={excerpt} image={image}>
  <article class={`tone--${tone}`}>
    <header class="wrap article-head">
      <div class="inner">
        <nav class="crumbs" aria-label="مسار التنقل">
          <a href="/blog">المدونة</a>
          {cats.length > 0 && <span class="sep" aria-hidden="true">/</span>}
          {cats.map((c) => <CatLabel slug={c} />)}
        </nav>
        <h1>{title}</h1>
        <div class="meta">
          <span><Icon name="calendar" size={16} /><time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time></span>
          <span><Icon name="clock" size={16} />{readingLabel(post.body)}</span>
        </div>
      </div>
    </header>
    <div class="wrap">
      {image && <figure class="article-cover"><img src={image} alt="" fetchpriority="high" decoding="async" /></figure>}
      <div class:list={['article-body', { 'has-toc': hasToc }]}>
        {hasToc && (
          <nav class="toc toc-desktop" aria-labelledby="toc-title">
            <h2 id="toc-title">في هذا المقال</h2>
            <ol>{toc.map((h) => <li class:list={{ sub: h.depth === 3 && toc.some((x) => x.depth === 2) }}><a href={`#${h.slug}`} data-toc={h.slug}>{h.text}</a></li>)}</ol>
          </nav>
        )}
        <div class="prose">
          {hasToc && (
            <details class="toc toc-mobile">
              <summary>في هذا المقال <Icon name="chevron" size={18} /></summary>
              <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </details>
          )}
          <Content />
        </div>
      </div>
      <footer class="article-foot">
        <div class="consult">
          <span class="mini"><Hawan size={72} animate={false} decorative /></span>
          <p>عندك سؤال عن دراستك أو مسارك المهني؟<span>احجز استشارة خاصة مع موضي.</span></p>
          <a href={site.booking} class="btn btn-primary"><Icon name="chat" /> احجز استشارة</a>
        </div>
        {(newer || older) && (
          <nav class="pager" aria-label="مقالات أخرى">
            {older ? <a href={`/posts/${older.id}`} rel="prev"><small><Icon name="arrow" size={15} flip /> المقال السابق</small><span class="story-title">{older.data.title}</span></a> : <span></span>}
            {newer && <a class="next" href={`/posts/${newer.id}`} rel="next"><small>المقال التالي <Icon name="arrow" size={15} /></small><span class="story-title">{newer.data.title}</span></a>}
          </nav>
        )}
      </footer>
    </div>
  </article>
  <section class="related" aria-labelledby="related">
    <div class="wrap">
      <div class="section-head">
        <h2 id="related">{related.length ? 'مقالات ذات صلة' : 'اقرأ أيضاً'}</h2>
        <a href="/blog" class="link-more">كل المقالات <Icon name="arrow" size={18} /></a>
      </div>
      <div class="post-grid">{more.map((p) => <PostCard post={p} />)}</div>
    </div>
  </section>
  {hasToc && (
    <script>
      const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) {
          links.forEach((a) => a.removeAttribute('aria-current'));
          links.get(e.target.id)?.setAttribute('aria-current', 'true');
        }
      }, { rootMargin: '-90px 0px -70% 0px' });
      links.forEach((_, id) => { const h = document.getElementById(id); if (h) io.observe(h); });
    </script>
  )}
</Base>
