---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import { policyCategories } from '../data/site';
const all = (await getCollection('policies')).sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const groups = Object.entries(policyCategories)
  .map(([key, name]) => ({ key, name, items: all.filter((p) => p.data.category === key) }))
  .filter((g) => g.items.length);
const fmt = (d: Date) => d.toLocaleDateString('ar-KW-u-nu-latn', { year: 'numeric', month: 'long', day: 'numeric' });
---
<Base title="سياسات وزارة الصحة الكويتية" description="القوانين والقرارات الوزارية الكويتية الخاصة بالصيدلة وتراخيص المهنة والأدوية.">
  <div class="page-head">
    <div class="wrap">
      <h1>سياسات وزارة الصحة الكويتية</h1>
      <p>القوانين والقرارات الوزارية المنشورة المتعلقة بالصيدلة وتراخيص مزاولة المهنة وتسجيل الأدوية وتداولها.</p>
    </div>
  </div>
  <section class="section" style="padding-top:8px">
    <div class="wrap" style="max-width:920px">
      <p class="notice"><Icon name="info" size={18} /><span>هذه الصفحة دليل مرجعي وليست بديلاً عن النص الرسمي. الروابط تقود إلى مصدر نشر كل قرار؛ تأكد دائماً من النص المعتمد في الجريدة الرسمية «الكويت اليوم» أو من وزارة الصحة قبل الاعتماد عليه.</span></p>
      <div class="toolbar">
        <form class="searchbox" role="search" onsubmit="return false">
          <label for="policy-search" class="sr">ابحث في السياسات</label>
          <Icon name="search" />
          <input id="policy-search" type="search" placeholder="ابحث برقم القرار أو الموضوع… مثلاً: 160، تراخيص، المخدرات" autocomplete="off" data-psearch />
        </form>
      </div>
      {groups.map((g) => (
        <section class="policy-group" data-group aria-labelledby={`g-${g.key}`}>
          <h2 class="group-title" id={`g-${g.key}`}>{g.name} <span class="count">{g.items.length}</span></h2>
          {g.items.map((p) => (
            <div class="policy" data-ptext={`${p.data.title} ${p.data.title_en ?? ''} ${p.data.number ?? ''} ${p.data.summary ?? ''}`}>
              <h3>{p.data.title}</h3>
              {p.data.title_en && <p class="en">{p.data.title_en}</p>}
              {p.data.summary && <p class="sum">{p.data.summary}</p>}
              <div class="row">
                {p.data.number && <span class="num">{p.data.number}</span>}
                {p.data.date && <span><time datetime={p.data.date.toISOString().slice(0, 10)}>{fmt(p.data.date)}</time></span>}
                <a href={p.data.url} target="_blank" rel="noopener">{p.data.category === 'official' ? 'زيارة الموقع' : 'قراءة القرار'} <Icon name="external" size={15} /><span class="sr">(تفتح في نافذة جديدة)</span></a>
                {p.data.source && <span>المصدر: {p.data.source}</span>}
              </div>
            </div>
          ))}
        </section>
      ))}
      <div class="empty" data-pempty hidden><strong>ما لقينا قرارات بهذه الكلمات.</strong>جرّب رقم القرار فقط، مثل 160.</div>
    </div>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>('[data-psearch]')!;
    const norm = (s: string) => s.toLowerCase().replace(/[أإآ]/g, 'ا').replace(/ة/g, 'ه').replace(/ى/g, 'ي');
    input.addEventListener('input', () => {
      const q = norm(input.value.trim()); let any = false;
      document.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => {
        let n = 0;
        g.querySelectorAll<HTMLElement>('.policy').forEach((p) => { const ok = !q || norm(p.dataset.ptext!).includes(q); p.hidden = !ok; if (ok) n++; });
        g.hidden = n === 0; if (n) any = true;
      });
      document.querySelector<HTMLElement>('[data-pempty]')!.hidden = any;
    });
  </script>
</Base>
