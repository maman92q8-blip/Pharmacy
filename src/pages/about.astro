---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';
---
<Base title="من أنا">
  <div class="page-head"><div class="wrap"><h1>من أنا؟</h1></div></div>
  <section class="section" style="padding-top:8px">
    <div class="wrap about">
      <div class="about-art"><img src="/images/2022-06-logo334.png" alt={`شعار ${site.name}`} /></div>
      <div>
        <p class="bio">إسمي موضي و محبه للعطاء. تخرجت من كليه الصيدله بدرجه البكالريوس ‎(BPharm).</p>
        <ul class="cred-list">
          <li><Icon name="check" />بدأت العمل في وزارة الصحة في الكويت</li>
          <li><Icon name="check" />ماجستير الصيدلة الإكلينيكية من جامعة كلية لندن ‎(UCL)</li>
          <li><Icon name="check" />حاصلة على البورد الأمريكي في العلاجيات ‎(BCPS)</li>
        </ul>
        <div class="btns">
          <a href={site.booking} class="btn btn-primary"><Icon name="chat" /> احجز استشارة</a>
          <a href={site.social.instagram} class="btn btn-quiet"><Icon name="instagram" /> Instagram</a>
          <a href={site.social.youtube} class="btn btn-quiet"><Icon name="youtube" /> YouTube</a>
        </div>
      </div>
    </div>
  </section>
</Base>
