---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
const all = await getCollection('resources');
const sections = [
  { key: 'courses', title: 'دورات مجانية', icon: 'calendar', sub: 'دورات أونلاين من منظمات وجامعات عالمية' },
  { key: 'youtube', title: 'قنوات يوتيوب للدراسة', icon: 'youtube', sub: 'أفضل القنوات لشرح الفارماكولوجي والفسيولوجي' },
  { key: 'references', title: 'مراجع ومواقع صيدلانية', icon: 'book', sub: 'مراجع موثوقة للأدوية والحمل والرضاعة' },
  { key: 'apps', title: 'تطبيقات الصيدلي', icon: 'doc', sub: 'تطبيقات يومية للجرعات والتداخلات' },
];
---
<Base title="المراجع الصيدلانية" description="دورات مجانية، قنوات يوتيوب للفارماكولوجي، مراجع وتطبيقات للصيادلة وطلبة الصيدلة.">
  <div class="page-head">
    <div class="wrap">
      <h1>المراجع الصيدلانية</h1>
      <p>دورات مجانية، قنوات يوتيوب للدراسة، مراجع موثوقة وتطبيقات يحتاجها كل صيدلي وطالب صيدلة.</p>
      <nav class="filters" style="margin-top:18px" aria-label="أقسام الصفحة">
        {sections.map((s) => <a class="chip" style="padding:6px 14px;font-size:15px" href={`#${s.key}`}>{s.title}</a>)}
      </nav>
    </div>
  </div>
  <section class="section" style="padding-top:28px">
    <div class="wrap">
      <a href="/posts/best-pharmacy-apps" class="policy-banner" style="text-decoration:none;margin-bottom:40px">
        <div class="badge"><Icon name="book" size={30} /></div>
        <div>
          <h2>مقال: أفضل تطبيقات الصيدلي</h2>
          <p style="margin:0">Lexidrug و Medscape و Epocrates و BNF، وتطبيقات الأدوية أثناء الحمل والرضاعة، مع مقارنة المجاني والمدفوع.</p>
        </div>
      </a>
      {sections.map((s) => {
        const items = all.filter((r) => r.data.section === s.key);
        return items.length > 0 && (
          <div class="policy-group" id={s.key} style="scroll-margin-top:90px">
            <h2><Icon name={s.icon} size={24} /> {s.title} <span class="count">{items.length}</span></h2>
            <p style="color:var(--muted);margin:-6px 0 16px">{s.sub}</p>
            <div class="res-grid">
              {items.map((r) => (
                <a class="res" href={r.data.url} target="_blank" rel="noopener">
                  <div class="res-top">
                    <strong dir="auto">{r.data.name}</strong>
                    <span class:list={['tag', { paid: !r.data.free }]}>{r.data.free ? 'مجاني' : 'مدفوع جزئياً'}</span>
                  </div>
                  {r.data.desc && <p>{r.data.desc}</p>}
                  <span class="go">زيارة <Icon name="external" size={15} /></span>
                </a>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </section>
</Base>
