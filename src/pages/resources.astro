---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
const all = await getCollection('resources');
const sections = [
  { key: 'courses', title: 'دورات مجانية', icon: 'calendar', sub: 'دورات أونلاين من منظمات وجامعات عالمية' },
  { key: 'youtube', title: 'قنوات يوتيوب للدراسة', icon: 'youtube', sub: 'أفضل القنوات لشرح الفارماكولوجي والفسيولوجي' },
  { key: 'references', title: 'مراجع ومواقع صيدلانية', icon: 'book', sub: 'مراجع موثوقة للأدوية والحمل والرضاعة' },
  { key: 'apps', title: 'تطبيقات الصيدلي', icon: 'doc', sub: 'تطبيقات يومية للجرعات والتداخلات' },
].map((s) => ({ ...s, items: all.filter((r) => r.data.section === s.key) })).filter((s) => s.items.length);
---
<Base title="المراجع الصيدلانية" description="دورات مجانية، قنوات يوتيوب للفارماكولوجي، مراجع وتطبيقات للصيادلة وطلبة الصيدلة.">
  <div class="page-head">
    <div class="wrap">
      <h1>المراجع الصيدلانية</h1>
      <p>دورات مجانية، قنوات يوتيوب للدراسة، مراجع موثوقة وتطبيقات يحتاجها كل صيدلي وطالب صيدلة.</p>
      <nav class="jump" aria-label="أقسام الصفحة">
        {sections.map((s) => <a href={`#${s.key}`}><Icon name={s.icon} size={18} />{s.title}</a>)}
      </nav>
    </div>
  </div>
  <section class="section" style="padding-top:24px">
    <div class="wrap">
      <a href="/posts/best-pharmacy-apps" class="feature-link">
        <span class="badge"><Icon name="book" size={26} /></span>
        <span><strong>مقال: أفضل تطبيقات الصيدلي</strong><span>Lexidrug و Medscape و Epocrates و BNF، وتطبيقات الأدوية أثناء الحمل والرضاعة، مع مقارنة المجاني والمدفوع.</span></span>
        <Icon name="arrow" size={22} />
      </a>
      {sections.map((s) => (
        <section class="res-section" id={s.key} aria-labelledby={`h-${s.key}`}>
          <h2 class="group-title" id={`h-${s.key}`} style="border:0;padding:0">{s.title} <span class="count">{s.items.length}</span></h2>
          <p>{s.sub}</p>
          <div class="res-grid">
            {s.items.map((r) => (
              <a class="res" href={r.data.url} target="_blank" rel="noopener">
                <strong dir="auto">{r.data.name}</strong>
                <span class:list={['free', { paid: !r.data.free }]}>{r.data.free ? 'مجاني' : 'مدفوع جزئياً'}</span>
                {r.data.desc && <p>{r.data.desc}</p>}
              </a>
            ))}
          </div>
        </section>
      ))}
    </div>
  </section>
</Base>
